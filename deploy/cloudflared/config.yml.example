# ============================================================================
# cloudflared — NOMLANGAN (permanent) tunnel namunasi
# ============================================================================
# Tezkor `trycloudflare` tunneli FAQAT sinov uchun: manzil har ishga
# tushirishda o'zgaradi va bir vaqtdagi so'rovlar soni cheklangan.
# Doimiy sayt uchun quyidagilarni bajaring (bir marta):
#
#   1) cloudflared tunnel login
#   2) cloudflared tunnel create wc-cinema
#        -> ~/.cloudflared/<UUID>.json  (credentials)
#   3) cloudflared tunnel route dns wc-cinema cinema.example.com
#   4) bu faylni ~/.cloudflared/config.yml ga ko'chirib, <...> larni to'ldiring
#   5) cloudflared tunnel run wc-cinema        (yoki systemd: wc-cloudflared)
#
# Cloudflare hisobida domen (nameserver'lari CF'ga o'tkazilgan) bo'lishi shart.
# ============================================================================

tunnel: <TUNNEL_UUID>
credentials-file: C:\Users\<user>\.cloudflared\<TUNNEL_UUID>.json

# Tunnelning o'zi uchun log darajasi (muammo bo'lsa "debug")
loglevel: info

# MUHIM: origin — Apache/Nginx. XAMPP'da 80, VPS'da odatda 80 (nginx -> php-fpm).
ingress:
  - hostname: cinema.example.com
    service: http://127.0.0.1:80
    originRequest:
      connectTimeout: 15s
      # HLS segmentlari katta fayl; Cloudflare orqali 100 MB dan katta
      # javob o'tmaydi (bepul tarif). HLS_SEG_SEC ni shunga moslang.

  # Ichki admin panelni faqat o'zingizga ochish (ixtiyoriy):
  # - hostname: admin.example.com
  #   service: http://127.0.0.1:80
  #   originRequest:
  #     access:
  #       required: true
  #       teamName: <your-team>

  # Qolgan barcha hostlar — 404
  - service: http_status:404
